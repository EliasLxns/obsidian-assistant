# Kopieren nach .env und anpassen. .env wird nie committet.
# Hier stehen nur Platzhalter: echte IPs, MAC-Adressen und Pfade gehören nur in deine .env.

# Ollama für die CLI (assistant index/ask/eval direkt auf dem Rechner)
OLLAMA_URL=http://localhost:11434
# Ollama aus Sicht der Docker-Container:
#   vorerst (alles auf dem Gaming-PC, Docker Desktop): http://host.docker.internal:11434 (Standard)
#   später (Mini-PC): http://<IP-des-Gaming-PCs>:11434
# OLLAMA_URL_DOCKER=http://<IP-des-Gaming-PCs>:11434
EMBED_MODEL=bge-m3
CHAT_MODEL=qwen2.5:7b-instruct-q4_K_M
# Sekunden, bis eine Anfrage an Ollama abbricht (erste Anfrage lädt das Modell)
OLLAMA_TIMEOUT=120

# Vault (für Entwicklung den Demo-Vault nutzen)
VAULT_PATH=./demo_vault
VAULT_NAME=demo_vault
# Nur Docker: Ordner auf dem Host, der nach /vault eingebunden wird (nur lesend)
#   Windows: VAULT_HOST_PATH=<Laufwerk>:/<Pfad>/<Vault>   (Schrägstriche nach vorn)
#   Linux:   VAULT_HOST_PATH=/home/<nutzer>/Obsidian/<Vault>
# VAULT_HOST_PATH=

# ChromaDB
CHROMA_PATH=./.chroma
# Cache für Embeddings (Hash aus Modell + Text)
EMBED_CACHE_PATH=./.cache/embeddings.sqlite3
# Nur Docker: docker-compose.yml setzt CHROMA_HOST=chroma selbst
# CHROMA_HOST=chroma
# CHROMA_PORT=8000

# API, Dashboard und Watcher
# API_PORT=8080
# DASHBOARD_PORT=8501
# Nur ohne Docker: Adresse der API für das Dashboard
# API_URL=http://localhost:8080
# Docker Desktop unter Windows meldet Dateiänderungen nicht in den Container.
# Dann fragt der Watcher alle 10 s ab. Auf dem Mini-PC (Linux) auf false stellen.
WATCH_POLLING=true

# Nachtjob (Phase 3)
# Startzeit im Dienstbetrieb und erlaubtes Zeitfenster (Ortszeit, TZ im Container)
NIGHTLY_TIME=03:00
NIGHTLY_WINDOW=01:00-06:00
# Läufe (für Rückgängig) und Pause-Schalter; im Container ein eigenes Volume
NIGHTLY_STATE_PATH=./.nachtjob
# Gaming-Schutz: true = den PC in Ruhe lassen, wenn er schon lief (erst auf dem Mini-PC sinnvoll)
NIGHTLY_SKIP_IF_AWAKE=false
# INBOX_DIR=00 Inbox
# TZ=Europe/Berlin

# Wake-on-LAN: leer lassen, solange alles auf dem Gaming-PC läuft
# GAMING_PC_MAC=<MAC-Adresse>
# WOL_BROADCAST=255.255.255.255
# Sekunden, die der Nachtjob nach dem Wecken auf Ollama wartet
# WOL_WAIT_S=180

# Gaming-PC nach getaner Arbeit ausschalten (nur wenn der Nachtjob ihn geweckt hat).
# Leer = nie ausschalten. Einrichtung: docs/gaming-pc-ausschalten.md
#   vorerst (Stack auf dem Gaming-PC): <benutzer>@host.docker.internal
#   später (Mini-PC):                  <benutzer>@<IP-des-Gaming-PCs>
# GAMING_PC_SSH=
# Schlüssel liegt in ./secrets/gaming_pc_ed25519 (Compose bindet ./secrets ein)
# Minuten Ruhe am Stück, bevor ausgeschaltet wird, und wie lange höchstens gewartet wird
# SHUTDOWN_RUHE_MIN=15
# SHUTDOWN_MAX_WARTEN_MIN=120
