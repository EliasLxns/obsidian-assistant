{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$(python3 -c \"\" 2>/dev/null && echo python3 || echo python) -X utf8 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_python.py\"",
            "timeout": 180
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$(python3 -c \"\" 2>/dev/null && echo python3 || echo python) -X utf8 \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_tests.py\"",
            "timeout": 320
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$(python3 -c \"\" 2>/dev/null && echo python3 || echo python) -X utf8 \"$CLAUDE_PROJECT_DIR/.claude/hooks/capture_rules.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
